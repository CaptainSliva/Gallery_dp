<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listAlbumsFragment">

    <fragment
        android:id="@+id/listAlbumsFragment"
        android:name="com.example.gallery_dp.ui.ListAlbumsFragment"
        android:label="@string/albums"
        tools:layout="@layout/list_albums_fragment">
        <action
            android:id="@+id/action_listAlbumsFragment_to_listPicturesFragment"
            app:destination="@id/listPicturesFragment" />
    </fragment>
    <fragment
        android:id="@+id/listPicturesFragment"
        android:name="com.example.gallery_dp.ui.ListPicturesFragment"
        android:label="@string/all_photos"
        tools:layout="@layout/list_pictures_fragment" >
        <action
            android:id="@+id/action_listPicturesFragment_to_fullscreenMediaFragment"
            app:destination="@id/fullscreenMediaFragment" />
        <action
            android:id="@+id/action_listPicturesFragment_to_chooseAlbumFragment"
            app:destination="@id/chooseAlbumFragment" />
    </fragment>
    <fragment
        android:id="@+id/fullscreenMediaFragment"
        android:name="com.example.gallery_dp.ui.FullscreenMediaFragment"
        android:label="fragment_fullscreen_media"
        tools:layout="@layout/fragment_fullscreen_media" />
    <fragment
        android:id="@+id/chooseAlbumFragment"
        android:name="com.example.gallery_dp.ui.ChooseAlbumFragment"
        android:label="fragment_choose_album"
        tools:layout="@layout/fragment_choose_album" >
        <action
            android:id="@+id/action_chooseAlbumFragment_to_listPicturesFragment"
            app:destination="@id/listPicturesFragment" />
    </fragment>


</navigation>